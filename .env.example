# Neon: connection string (با sslmode=require). بهتر است منطقه‌ی Neon = AWS eu-central-1 (فرانکفورت) باشد تا با fra1 ورسل هماهنگ باشد
DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# حداقل ۳۲ کاراکتر تصادفی:  openssl rand -base64 48
AUTH_SECRET=

# عمر access token (ثانیه). اپ فلاتر فعلی refresh ندارد؛ تا زمان اضافه‌شدن آن می‌توانید مثلاً 2592000 (۳۰ روز) بگذارید
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# آدرس عمومی همین سایت (بدون / انتهایی)؛ برای callback درگاه‌های پرداخت
APP_URL=https://your-backend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# آدرس فرانت‌های جدا (با کاما)، مثل https://my-frontend.vercel.app
CORS_ALLOWED_ORIGINS=

# ذخیره‌ی تصاویر (S3-سازگار، مثل پارس‌پک). روی ورسل فایل‌سیستم دائمی نداریم
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=
# S3_ACL=public-read

# پیامک (کاوه‌نگار - قالب verify/lookup با یک توکن)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify

# ایمیل (Resend)
RESEND_API_KEY=
MAIL_FROM="Restaurant <no-reply@yourdomain.com>"

# فقط برای اسکریپت seed (ساخت اولین ادمین)
ADMIN_IDENTIFIER=
ADMIN_PASSWORD=
